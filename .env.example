# Copie para .env. Node carrega com: node --env-file=.env server/index.ts
NODE_ENV=production
APP_ORIGIN=https://seu-dominio.example
PORT=3001
HOST=127.0.0.1
DB_PATH=.data/aqui.sqlite
# Produção exige SMTP configurado. Nenhum e-mail é enviado na demonstração local.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
